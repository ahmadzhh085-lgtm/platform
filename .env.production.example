# ============================================
# Production Environment Variables for Railway
# ============================================

APP_NAME=Laravel
APP_ENV=production
APP_KEY=base64:xOdj/DQJ6vv5nsB90CqGjeQMl9ZGK2aSt/ZP/DLmd/o=
APP_DEBUG=false
APP_URL=https://zoological-flow-production-40af.up.railway.app

# ============================================
# Cloudinary Configuration (RECOMMENDED)
# ============================================
FILESYSTEM_DISK=local
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ============================================
# Alternative: AWS S3 Configuration
# ============================================
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=your-bucket-name
# AWS_URL=https://your-bucket.s3.amazonaws.com

# ============================================
# Database Configuration (Aiven PostgreSQL)
# ============================================
DB_CONNECTION=pgsql
DB_HOST=your-aiven-host.a.aivencloud.com
DB_PORT=12345
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_SSLMODE=require

# ============================================
# Cache & Session
# ============================================
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ============================================
# Redis Configuration (if using)
# ============================================
REDIS_HOST=your-redis-host.a.aivencloud.com
REDIS_PASSWORD=your_redis_password
REDIS_PORT=12345

# ============================================
# Logging
# ============================================
LOG_CHANNEL=stack
LOG_LEVEL=warning

# ============================================
# Mail Configuration (if needed)
# ============================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@investment-platform.com
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# Broadcasting
# ============================================
BROADCAST_CONNECTION=log

# ============================================
# Miscellaneous
# ============================================
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12
